# Template for production. Place it once as `.env` next to `artisan` and fill it
# in — the file is not in the repository and is not touched by any deployment.
# `.env.example` alongside describes the development setup.

APP_NAME="QWV Reservationen"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://reservation-neu.quartierwerkstatt-viktoria.ch

# Generate once locally and paste in here:
#   php artisan key:generate --show
# Do not run it as a deployment action — `key:generate` would write a new key on
# every deploy and thereby invalidate all sessions.
APP_KEY=

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_MAINTENANCE_DRIVER=file

# Rotating daily rather than into a single file: on the shared hosting there is
# nobody to clear away an indefinitely growing `laravel.log`.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessions and cache in the database: there is no Redis, and the file cache would
# live in the deployment directory.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database

# No long-running processes on the hosting, so no queue workers.
QUEUE_CONNECTION=sync

# Photos live under `storage/app/public` and are served through the
# `public/storage` symlink.
FILESYSTEM_DISK=local
