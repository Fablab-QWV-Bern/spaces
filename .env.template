# Vorlage für die Produktion. Einmalig als `.env` neben `artisan` ablegen und
# ausfüllen — die Datei liegt nicht im Repository und wird von keiner
# Bereitstellung angefasst. `.env.example` daneben beschreibt die Entwicklung.

APP_NAME="QWV Reservationen"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://reservation-neu.quartierwerkstatt-viktoria.ch

# Einmalig lokal erzeugen und hier einsetzen:
#   php artisan key:generate --show
# Nicht als Bereitstellungsaktion laufen lassen — `key:generate` würde bei jedem
# Deploy einen neuen Schlüssel schreiben und damit alle Sitzungen entwerten.
APP_KEY=

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_MAINTENANCE_DRIVER=file

# Täglich rotierend statt in eine einzige Datei: auf dem geteilten Hosting gibt
# es niemanden, der eine unbegrenzt wachsende `laravel.log` abräumt.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sitzungen und Cache in der Datenbank: kein Redis, und der Dateicache läge im
# Bereitstellungsverzeichnis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database

# Keine dauerhaft laufenden Prozesse auf dem Hosting, also keine Queue-Worker.
QUEUE_CONNECTION=sync

# Fotos liegen unter `storage/app/public` und gehen über den Symlink
# `public/storage` hinaus.
FILESYSTEM_DISK=local
